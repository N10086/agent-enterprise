# 模型接入配置（复制为 .env 后填写）
# 走 OpenAI 兼容协议，填任意一家端点都能用，例如：
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
#   GLM:       https://open.bigmodel.cn/api/paas/v4
#   Kimi:      https://api.moonshot.cn/v1
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 各家的独立 key（也可以直接在网页界面上填，那个只存在浏览器本地）
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPUAI_API_KEY=
# MOONSHOT_API_KEY=
# OPENAI_DIRECT_API_KEY=

# ---- 知识库（可选）----
# 嵌入模型：语料是中文时可以换成 BAAI/bge-small-zh-v1.5
# KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 检索片段数
# KB_TOP_K=5
# 检索质检开关与触发线（0 表示每次都质检）
# KB_GRADE_RETRIEVAL=1
# KB_GRADE_SCORE=0.55

# ---- 外部 MCP server（可选）----
# MCP_SERVERS={"some-server":{"command":"python","args":["path/to/server.py"]}}
