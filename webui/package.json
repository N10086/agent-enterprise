{
  "name": "agent-enterprise-webui",
  "private": true,
  "version": "2.0.0",
  "description": "Agent Enterprise 的本地网页界面（TypeScript + esbuild）",
  "scripts": {
    "build": "esbuild src/main.ts src/settings.ts --bundle --minify --target=es2020 --outdir=dist --log-level=info",
    "watch": "esbuild src/main.ts src/settings.ts --bundle --target=es2020 --outdir=dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
